Table products [headercolor: #F97316] {
    Note: '''
A product model identified by brand, model, and manufacturer. Variants, their
selections, and concrete SKUs live in child tables.
'''

    id           BIGINT      [pk, increment]
    brand        TEXT        [not null]
    model        TEXT        [not null]
    manufacturer TEXT        [not null]
    description  TEXT        [not null, default: '']
    created_at   timestamptz [not null, default: `NOW()`]
    updated_at   timestamptz
    created_by   BIGINT
    updated_by   BIGINT

    Indexes {
        (brand, model, manufacturer) [unique, name: 'uq_products_brand_model_manufacturer']
    }
}

Table product_variants [headercolor: #EA580C] {
    Note: '''
A variant dimension of a product, such as Color or Storage. Names are unique per
product.
'''

    id         BIGINT      [pk, increment]
    product_id BIGINT      [not null]
    name       TEXT        [not null]
    created_at timestamptz [not null, default: `NOW()`]
    updated_at timestamptz
    created_by BIGINT
    updated_by BIGINT

    Indexes {
        (product_id, name) [unique, name: 'uq_product_variants_product_id_name']
    }
}

Table product_variant_selections [headercolor: #FB923C] {
    Note: '''
A selectable value of a variant dimension, such as Black or 256GB. Names are unique
per variant.
'''

    id                 BIGINT      [pk, increment]
    product_variant_id BIGINT      [not null]
    name               TEXT        [not null]
    description        TEXT        [not null, default: '']
    created_at         timestamptz [not null, default: `NOW()`]
    updated_at         timestamptz
    created_by         BIGINT
    updated_by         BIGINT

    Indexes {
        (product_variant_id, name) [unique, name: 'uq_product_variant_selections_product_variant_id_name']
    }
}

Table product_skus [headercolor: #F59E0B] {
    Note: '''
The concrete sellable unit: a product combined with one selection per variant.

SKUs are generated, never authored: they appear once every variant has at least one
selection and the combination count is under the application cap. Any later change to
the variants or selections re-runs generation inside the same transaction, so deleting
a variant or selection needs no separate path.

The database does not do this. No foreign key can delete a SKU because its child count
dropped, so a variant or selection delete leaves SKUs (and their prices and stock) in
place. The application must run the cleanup below, in the same transaction as the
design change; if it forgets, malformed SKUs survive silently and nothing complains.

Generation diffs against selection_key instead of wiping the product:
desired = one key per valid combination, existing = current keys for the product.
Missing keys are inserted, shared keys are left untouched so their prices and stock
survive, and keys that disappeared are deleted. Deleting a variant or a selection is
just a design change: recompute the valid key set, then remove every SKU of the product
whose key is not in it. Since prices and inventories cascade from sku_id, that one
delete also removes their pricing and stock. Renaming a variant or adding an option
therefore never destroys stock.

Inventories cascade from sku_id and from location_id, so the database never protects
stock. The application must guard the operation before it runs: list the affected SKUs
with the locations and quantities on hand, require explicit confirmation, and record a
write-off so audited stock is not destroyed unaccounted for.

selection_key is the deterministic identity: the sorted selection identifiers joined by
"-". A newly generated SKU has no price, because prices fall back from an outlet row to
the global row of the same SKU, never to a product-wide default.
code is an optional immutable business identifier for labels, barcodes, or imports —
a value, never a join key.
'''

    id            BIGINT      [pk, increment]
    product_id    BIGINT      [not null]
    selection_key TEXT        [not null, default: '', note: 'Sorted selection identifiers joined by "-"; empty when the product has no variants.']
    code          TEXT        [note: 'Optional immutable business identifier; unique per product when set.']
    created_at    timestamptz [not null, default: `NOW()`]
    updated_at    timestamptz
    created_by    BIGINT
    updated_by    BIGINT

    Indexes {
        (product_id, selection_key) [unique, name: 'uq_product_skus_product_id_selection_key']
        (product_id, code)          [unique, name: 'uq_product_skus_product_id_code']
    }
}

Table product_sku_selections [headercolor: #D97706] {
    Note: '''
Binds one variant selection to a SKU. A SKU carries exactly one selection per variant;
the application enforces that rule.
'''

    id                   BIGINT      [pk, increment]
    sku_id               BIGINT      [not null]
    variant_selection_id BIGINT      [not null]
    created_at           timestamptz [not null, default: `NOW()`]

    Indexes {
        (sku_id, variant_selection_id) [unique, name: 'uq_product_sku_selections_sku_id_variant_selection_id']
    }
}

Table prices [headercolor: #CA8A04] {
    Note: '''
The price of a SKU in one currency. A NULL location_id is the global price; a set
location_id overrides it for that site. Lookups always fall back to the global row,
so a missing outlet-specific row is not an error.

Deleting a location cascades its overrides, so the affected SKUs fall back to global
pricing. amount is exact decimal. Two partial unique indexes keep the scopes separate:
global rows are unique per (sku_id, currency) and outlet rows per
(sku_id, currency, location_id). A plain unique index would allow duplicate global
rows because NULL is distinct from NULL. There is no price history; a price is
overwritten in place.
'''

    id          BIGINT      [pk, increment]
    sku_id      BIGINT      [not null]
    location_id BIGINT      [note: 'NULL is the global price; otherwise overrides it for that location.']
    currency    TEXT        [not null, note: 'ISO 4217 code, e.g. IDR.']
    amount      NUMERIC     [not null, note: 'Exact decimal amount.']
    created_at  timestamptz [not null, default: `NOW()`]
    updated_at  timestamptz
    created_by  BIGINT
    updated_by  BIGINT

    Indexes {
        (sku_id, currency) [unique, name: 'uq_prices_global', note: 'Partial unique index: WHERE location_id IS NULL']
        (sku_id, currency, location_id) [unique, name: 'uq_prices_location', note: 'Partial unique index: WHERE location_id IS NOT NULL']
    }
}
