# Logger
PASHQ_LOGGER_FORMAT=json
PASHQ_LOGGER_LEVEL=INFO

# PostgreSQL
PASHQ_POSTGRES_HOST=127.0.0.1
PASHQ_POSTGRES_PORT=5432
PASHQ_POSTGRES_USERNAME=CHANGE_ME
PASHQ_POSTGRES_PASSWORD=CHANGE_ME
PASHQ_POSTGRES_DATABASE=pas_hq
# Accepted: disable, allow, prefer, require, verify-ca, verify-full.
PASHQ_POSTGRES_SSL_MODE=prefer
PASHQ_POSTGRES_MAX_CONNECTIONS=10
PASHQ_POSTGRES_CONNECT_TIMEOUT_MS=10000

# Cache backend: moka runs in-process; redis requires PASHQ_REDIS_URL.
PASHQ_CACHE_BACKEND=moka
PASHQ_CACHE_MAX_CAPACITY=10000
PASHQ_CACHE_INDIVIDUAL_TTL_MS=60000
PASHQ_CACHE_LIST_TTL_MS=10000
PASHQ_REDIS_URL=redis://127.0.0.1:6379

# Auth. One secret signs both access and refresh tokens; it must not be blank.
PASHQ_AUTH_ACCESS_SECRET=CHANGE_ME
# Access lifetime in milliseconds; defaults to 15 minutes.
PASHQ_AUTH_ACCESS_TTL_MS=900000
# Refresh lifetime in milliseconds; defaults to 24 hours.
PASHQ_AUTH_REFRESH_TTL_MS=86400000
PASHQ_AUTH_BCRYPT_COST=12
# How long resolved API key claims stay cached, in milliseconds.
PASHQ_AUTH_API_KEY_CACHE_TTL_MS=60000

# HTTP
PASHQ_HTTP_ADDR=0.0.0.0:8080
PASHQ_SHUTDOWN_TIMEOUT_MS=15000
